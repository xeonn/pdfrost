<?xml version="1.0" encoding="UTF-8"?>
<!-- Fill with Receipts.json. The file is a list. Each object is one receipt, and the list fills two pages. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Receipts" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<field name="receiptNo" class="java.lang.String"/>
	<field name="customer" class="java.lang.String"/>
	<field name="amount" class="java.lang.Integer"/>
	<field name="note" class="java.lang.String"/>
	<title>
		<band height="40" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="240" height="22"/>
				<textElement>
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Receipts]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="24" width="320" height="14"/>
				<text><![CDATA[One receipt for each object in the list]]></text>
			</staticText>
		</band>
	</title>
	<columnHeader>
		<band height="22" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="2" width="120" height="16"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Receipt]]></text>
			</staticText>
			<staticText>
				<reportElement x="140" y="2" width="220" height="16"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Customer]]></text>
			</staticText>
			<staticText>
				<reportElement x="400" y="2" width="80" height="16"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Amount]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="90" splitType="Stretch">
			<textField>
				<reportElement x="0" y="8" width="120" height="16"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{receiptNo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="140" y="8" width="240" height="16"/>
				<textFieldExpression><![CDATA[$F{customer}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="400" y="8" width="80" height="16"/>
				<textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="32" width="400" height="16"/>
				<textFieldExpression><![CDATA[$F{note}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="72" width="555" height="1"/>
			</line>
		</band>
	</detail>
	<summary>
		<band height="24" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="4" width="80" height="16"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Last receipt]]></text>
			</staticText>
			<textField>
				<reportElement x="90" y="4" width="120" height="16"/>
				<textFieldExpression><![CDATA[$F{receiptNo}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
	<pageFooter>
		<band height="24" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="4" width="40" height="16"/>
				<text><![CDATA[Page]]></text>
			</staticText>
			<textField>
				<reportElement x="40" y="4" width="40" height="16"/>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
